# Copy to ai-runner/.env (gitignored). The token must match the Worker secret:
#   npx wrangler secret put AI_RUNNER_TOKEN
CRESIQ_URL=https://cresiq.com
AI_RUNNER_TOKEN=
PROVIDERS=claude,openai
POLL_SECONDS=15

# Full paths are safest under launchd/systemd (no login shell PATH).
CLAUDE_BIN=/Users/you/.local/bin/claude
CODEX_BIN=/opt/homebrew/bin/codex
# CLAUDE_MODEL=opus
# CODEX_MODEL=

# Long-lived Claude auth (≈1 year): run `claude setup-token` once and paste it here.
# Without it the runner uses the CLI's normal login (Keychain on macOS).
# CLAUDE_CODE_OAUTH_TOKEN=
